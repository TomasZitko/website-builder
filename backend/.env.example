NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=postgresql://user:password@host:5432/database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-use-256-bits

# AI APIs
DEEPSEEK_API_KEY=sk-...
GEMINI_API_KEY=AIza...

# Design Inspiration APIs (at least ONE recommended)
# Pinterest API (BEST quality, requires approval): https://developers.pinterest.com/
PINTEREST_API_KEY=your-pinterest-api-key
# Unsplash API (FREE, 50 req/hour): https://unsplash.com/developers
UNSPLASH_API_KEY=your-unsplash-access-key
# Pexels API (FREE alternative): https://www.pexels.com/api/
PEXELS_API_KEY=your-pexels-api-key

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@webchat.cz
SMTP_PASS=your-app-password

# Encryption (for FTP passwords)
ENCRYPTION_KEY=generate-32-byte-hex-key-here

# Hosting
CADDY_DOMAIN=*.webchat.cz
SSL_EMAIL=admin@webchat.cz

/**
 * Dashboard - Glassmorphism Edition
 * COMPLETE REDESIGN with GSAP animations, glassmorphism, and stunning UI
 */

import { useEffect, useMemo } from 'react';
import { useNavigate } from 'react-router-dom';
import { motion } from 'framer-motion';
import {
  IconWorld,
  IconRocket,
  IconUsers,
  IconTrendingUp,
  IconPlus,
  IconLogout,
  IconSparkles
} from '@tabler/icons-react';
import { useAuthStore } from '@/store/authStore';
import { useWebsites } from '@/hooks/useWebsites';
import { GlassBackground } from '@/components/dashboard/GlassBackground';
import { StatsCard } from '@/components/dashboard/StatsCard';
import { ProjectCarousel } from '@/components/dashboard/ProjectCarousel';
import { ActivityFeed } from '@/components/dashboard/ActivityFeed';
import { QuickActions } from '@/components/dashboard/QuickActions';
import { Spinner } from '@/components/ui/Spinner';

export function Dashboard() {
  const user = useAuthStore((state) => state.user);
  const logout = useAuthStore((state) => state.logout);
  const navigate = useNavigate();
  const { websites, isLoading, fetchWebsites, deleteWebsite } = useWebsites();

  useEffect(() => {
    fetchWebsites();
  }, [fetchWebsites]);

  // Calculate stats from real data
  const stats = useMemo(() => ({
    totalWebsites: websites.length,
    publishedWebsites: websites.filter(w => w.isPublished).length,
    paidWebsites: websites.filter(w => w.isPaid).length,
    unpaidWebsites: websites.filter(w => !w.isPaid).length
  }), [websites]);

  const handleNewProject = () => {
    navigate('/builder');
  };

  const handleLogout = () => {
    logout();
    navigate('/login');
  };

  return (
    <div className="min-h-screen relative overflow-hidden">
      {/* Animated Background */}
      <GlassBackground />

      {/* Header - Glass Sticky */}
      <motion.header
        initial={{ y: -100, opacity: 0 }}
        animate={{ y: 0, opacity: 1 }}
        transition={{ duration: 0.6, ease: 'easeOut' }}
        className="
          sticky top-0 z-50
          bg-gradient-to-br from-background/80 to-background/60
          backdrop-blur-xl border-b border-foreground/[0.08]
          shadow-[0_8px_32px_0_rgba(0,0,0,0.12)]
        "
      >
        <div className="container mx-auto px-4 sm:px-6 lg:px-8 py-4">
          <div className="flex items-center justify-between">
            {/* Logo & Title */}
            <div className="flex items-center gap-3">
              <motion.div
                whileHover={{ rotate: 360, scale: 1.1 }}
                transition={{ duration: 0.6 }}
                className="
                  w-10 h-10 rounded-xl
                  bg-gradient-to-br from-violet-500 to-blue-600
                  flex items-center justify-center
                  shadow-lg
                "
              >
                <IconSparkles className="w-6 h-6 text-white" />
              </motion.div>
              <div>
                <h1 className="text-xl font-bold text-foreground">
                  WebChat.ai
                </h1>
                <p className="text-xs text-foreground/60">
                  AI Website Builder
                </p>
              </div>
            </div>

            {/* Action Buttons */}
            <div className="flex items-center gap-3">
              <motion.button
                whileHover={{ scale: 1.05 }}
                whileTap={{ scale: 0.95 }}
                onClick={handleNewProject}
                className="
                  px-4 py-2 sm:px-6 sm:py-2.5 rounded-xl
                  bg-gradient-to-r from-violet-500 to-blue-600
                  text-white font-semibold
                  shadow-lg shadow-violet-500/30
                  hover:shadow-xl hover:shadow-violet-500/40
                  transition-all duration-300
                  flex items-center gap-2
                "
              >
                <IconPlus className="w-5 h-5" />
                <span className="hidden sm:inline">New Website</span>
              </motion.button>

              <motion.button
                whileHover={{ scale: 1.05 }}
                whileTap={{ scale: 0.95 }}
                onClick={handleLogout}
                className="
                  p-2.5 rounded-xl
                  bg-gradient-to-br from-background/60 to-background/40
                  backdrop-blur-xl border border-foreground/[0.08]
                  hover:border-foreground/[0.12]
                  transition-all duration-300
                  text-foreground/60 hover:text-foreground
                "
                title="Logout"
              >
                <IconLogout className="w-5 h-5" />
              </motion.button>
            </div>
          </div>
        </div>
      </motion.header>

      {/* Main Content */}
      <main className="container mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
        {/* Welcome Section */}
        <motion.section
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ delay: 0.2, duration: 0.6 }}
          className="mb-12"
        >
          <h2 className="text-4xl sm:text-5xl font-bold text-foreground mb-3">
            Welcome back,{' '}
            <span className="bg-gradient-to-r from-violet-500 to-blue-600 bg-clip-text text-transparent">
              {user?.firstName || 'there'}
            </span>
            ! 👋
          </h2>
          <p className="text-lg text-foreground/60">
            Here's what's happening with your projects today
          </p>
        </motion.section>

        {/* Stats Grid */}
        <section className="mb-16">
          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <StatsCard
              title="Total Websites"
              value={stats.totalWebsites}
              change={stats.totalWebsites > 0 ? `${stats.publishedWebsites} published` : 'Get started'}
              icon={<IconWorld className="w-6 h-6" />}
              gradient="primary"
              index={0}
            />
            <StatsCard
              title="Published"
              value={stats.publishedWebsites}
              change={`${((stats.publishedWebsites / (stats.totalWebsites || 1)) * 100).toFixed(0)}% of total`}
              icon={<IconRocket className="w-6 h-6" />}
              gradient="success"
              index={1}
            />
            <StatsCard
              title="Paid Projects"
              value={stats.paidWebsites}
              change={stats.unpaidWebsites > 0 ? `${stats.unpaidWebsites} pending payment` : 'All paid'}
              icon={<IconTrendingUp className="w-6 h-6" />}
              gradient="info"
              index={2}
            />
            <StatsCard
              title="Active Users"
              value={1}
              change="You're amazing!"
              icon={<IconUsers className="w-6 h-6" />}
              gradient="warning"
              index={3}
            />
          </div>
        </section>

        {/* Projects Carousel */}
        {isLoading ? (
          <div className="flex items-center justify-center py-20">
            <Spinner size="lg" />
          </div>
        ) : (
          <>
            {websites.length > 0 && (
              <motion.section
                initial={{ opacity: 0, y: 20 }}
                animate={{ opacity: 1, y: 0 }}
                transition={{ delay: 0.4, duration: 0.6 }}
                className="mb-16"
              >
                <div className="flex items-center justify-between mb-8">
                  <div>
                    <h2 className="text-2xl sm:text-3xl font-bold text-foreground mb-2">
                      Recent Projects
                    </h2>
                    <p className="text-foreground/60">
                      Your latest AI-generated websites
                    </p>
                  </div>
                  {websites.length > 3 && (
                    <span className="text-sm text-foreground/60">
                      {websites.length} total
                    </span>
                  )}
                </div>
                <ProjectCarousel
                  projects={websites}
                  onDelete={deleteWebsite}
                  autoPlay={true}
                  autoPlayInterval={6000}
                />
              </motion.section>
            )}

            {/* Quick Actions Grid */}
            <motion.section
              initial={{ opacity: 0, y: 20 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ delay: 0.5, duration: 0.6 }}
              className="mb-16"
            >
              <div className="mb-8">
                <h2 className="text-2xl sm:text-3xl font-bold text-foreground mb-2">
                  Quick Actions
                </h2>
                <p className="text-foreground/60">
                  Jump right into what you need
                </p>
              </div>
              <QuickActions />
            </motion.section>

            {/* Activity Feed */}
            <motion.section
              initial={{ opacity: 0, y: 20 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ delay: 0.6, duration: 0.6 }}
              className="mb-16"
            >
              <div className="mb-8">
                <h2 className="text-2xl sm:text-3xl font-bold text-foreground mb-2">
                  Recent Activity
                </h2>
                <p className="text-foreground/60">
                  Track your latest actions and updates
                </p>
              </div>
              <div className="max-w-3xl">
                <ActivityFeed maxItems={5} />
              </div>
            </motion.section>
          </>
        )}

        {/* Empty State - Show when no projects */}
        {!isLoading && websites.length === 0 && (
          <motion.div
            initial={{ opacity: 0, scale: 0.95 }}
            animate={{ opacity: 1, scale: 1 }}
            transition={{ delay: 0.4, duration: 0.6 }}
            className="
              py-20 text-center
              bg-gradient-to-br from-background/60 to-background/40
              backdrop-blur-xl border border-foreground/[0.08]
              rounded-3xl
              shadow-[0_8px_32px_0_rgba(0,0,0,0.12)]
            "
          >
            <div className="max-w-md mx-auto px-6">
              <motion.div
                animate={{ y: [0, -10, 0] }}
                transition={{ duration: 2, repeat: Infinity }}
                className="
                  w-24 h-24 mx-auto mb-6
                  bg-gradient-to-br from-violet-500/20 to-blue-500/20
                  rounded-2xl
                  flex items-center justify-center
                "
              >
                <IconWorld className="w-12 h-12 text-foreground/40" />
              </motion.div>
              <h3 className="text-2xl font-bold text-foreground mb-3">
                No websites yet
              </h3>
              <p className="text-foreground/60 mb-6">
                Create your first AI-generated website to get started on your journey
              </p>
              <motion.button
                whileHover={{ scale: 1.05 }}
                whileTap={{ scale: 0.95 }}
                onClick={handleNewProject}
                className="
                  px-8 py-3 rounded-xl
                  bg-gradient-to-r from-violet-500 to-blue-600
                  text-white font-semibold
                  shadow-lg shadow-violet-500/30
                  hover:shadow-xl hover:shadow-violet-500/40
                  transition-all duration-300
                  inline-flex items-center gap-2
                "
              >
                <IconPlus className="w-5 h-5" />
                Create Your First Website
              </motion.button>
            </div>
          </motion.div>
        )}
      </main>

      {/* Footer */}
      <motion.footer
        initial={{ opacity: 0 }}
        animate={{ opacity: 1 }}
        transition={{ delay: 0.8, duration: 0.6 }}
        className="container mx-auto px-4 sm:px-6 lg:px-8 py-8 text-center"
      >
        <p className="text-sm text-foreground/40">
          Built with ❤️ by WebChat.ai • Powered by AI
        </p>
      </motion.footer>
    </div>
  );
}
